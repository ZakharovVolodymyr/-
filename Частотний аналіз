{"cells":[{"cell_type":"code","source":["import os\n","import cv2\n","import numpy as np\n","import matplotlib.pyplot as plt\n","from PIL import Image\n","from sklearn.model_selection import train_test_split\n","from sklearn.svm import SVC\n","from sklearn.metrics import accuracy_score\n","from google.colab import drive\n","\n","if not os.path.exists('/content/drive/MyDrive'):\n","    drive.mount('/content/drive')\n","\n","DATASET_DIR = '/content/drive/MyDrive/ai_vs_real_dataset2025' #https://www.kaggle.com/datasets/virajinduruwa/real-vs-fakeai-image-dataset\n","#REAL_DIR = os.path.join(DATASET_DIR, 'REAL') #закоментовано, бо у цьому датасеті клас реальних зображень отруєний, тобто містить ШІ зображення\n","#Було використані реальні зображення з цього датасету, все одно рельні зображенння не змінюються\n","REAL_DIR = os.path.join('/content/drive/MyDrive/ai_vs_real_dataset2024/Midjourney_Exp2/test', 'REAL') #\thttps://www.kaggle.com/datasets/mariammarioma/midjourney-imagenet-real-vs-synth\n","\n","FAKE_DIR = os.path.join(DATASET_DIR, 'FAKE')\n","\n","def process_path_to_fft(img_path, img_size=(256, 256)):\n","    pil_img = Image.open(img_path).convert('RGB')\n","\n","    img_gray = cv2.cvtColor(np.array(pil_img), cv2.COLOR_RGB2GRAY)\n","    img_gray = cv2.resize(img_gray, img_size)\n","\n","    f_transform = np.fft.fft2(img_gray)\n","    f_shift = np.fft.fftshift(f_transform)\n","    magnitude_spectrum = 20 * np.log(np.abs(f_shift) + 1e-8)\n","\n","    return pil_img, magnitude_spectrum\n","\n","def extract_azimuthal_profile(magnitude_spectrum):\n","    h, w = magnitude_spectrum.shape\n","    center_y, center_x = h // 2, w // 2\n","\n","    y, x = np.indices((h, w))\n","    r = np.sqrt((x - center_x)**2 + (y - center_y)**2).astype(int)\n","\n","    tbin = np.bincount(r.ravel(), magnitude_spectrum.ravel())\n","    nr = np.bincount(r.ravel())\n","    radial_profile = tbin / np.maximum(nr, 1)\n","\n","    max_radius = min(center_y, center_x)\n","    return radial_profile[:max_radius]\n","\n","X, y, raw_images, spectra = [], [], [], []\n","\n","real_paths = [\n","    os.path.join(REAL_DIR, f)\n","    for f in os.listdir(REAL_DIR)\n","    if f.lower().endswith(('.jpg', '.jpeg', '.png', '.webp'))\n","]\n","\n","fake_paths = [\n","    os.path.join(FAKE_DIR, f)\n","    for f in os.listdir(FAKE_DIR)\n","    if f.lower().endswith(('.jpg', '.jpeg', '.png', '.webp'))\n","]\n","\n","print(f\"Зчитано з Google Диску: {len(real_paths)} REAL та {len(fake_paths)} FAKE зображень.\")\n","print(\"Обробка зображень та обчислення спектрів Фур'є...\")\n","\n","for path in real_paths:\n","    pil_img, spec = process_path_to_fft(path)\n","    X.append(extract_azimuthal_profile(spec))\n","    y.append(1)\n","    raw_images.append(pil_img)\n","    spectra.append(spec)\n","\n","for path in fake_paths:\n","    pil_img, spec = process_path_to_fft(path)\n","    X.append(extract_azimuthal_profile(spec))\n","    y.append(0)\n","    raw_images.append(pil_img)\n","    spectra.append(spec)\n","\n","X = np.array(X)\n","y = np.array(y)\n","\n","X_train, X_test, y_train, y_test, raw_train, raw_test, spec_train, spec_test = train_test_split(\n","    X, y, raw_images, spectra, test_size=0.2, random_state=42, stratify=y\n",")\n","\n","print(\"Навчання SVM-класифікатора...\")\n","model = SVC(kernel='rbf', C=10.0, probability=True)\n","model.fit(X_train, y_train)\n","\n","y_pred = model.predict(X_test)\n","print(f\"\\nТочність (Accuracy) моделі: {accuracy_score(y_test, y_pred) * 100:.2f}%\")\n","\n","real_idx = next(i for i, label in enumerate(y_test) if label == 1)\n","ai_idx = next(i for i, label in enumerate(y_test) if label == 0)\n","\n","label_map = {1: \"REAL (Реальне)\", 0: \"FAKE (Згенероване ШІ)\"}\n","\n","print(\"\\n--- Демонстрація перевірки ---\")\n","\n","for title, idx in [(\"Реальне фото\", real_idx), (\"ШІ фото\", ai_idx)]:\n","    feat = X_test[idx].reshape(1, -1)\n","    pred = model.predict(feat)[0]\n","    prob = model.predict_proba(feat)[0]\n","\n","    print(f\"\\n[{title}]\")\n","    print(f\"  Дійсний клас:       {label_map[y_test[idx]]}\")\n","    print(f\"  Передбачення моделі: {label_map[pred]}\")\n","    print(f\"  Впевненість:         {prob[pred] * 100:.2f}%\")\n","\n","fig, axes = plt.subplots(2, 2, figsize=(9, 8))\n","\n","pred_real = model.predict(X_test[real_idx].reshape(1, -1))[0]\n","axes[0, 0].imshow(raw_test[real_idx])\n","axes[0, 0].set_title(f\"REAL Фото (з Диску)\\nПередбачено: {label_map[pred_real]}\")\n","axes[0, 0].axis('off')\n","\n","axes[0, 1].imshow(spec_test[real_idx], cmap='magma')\n","axes[0, 1].set_title(\"Спектр Фур'є (REAL)\")\n","axes[0, 1].axis('off')\n","\n","pred_ai = model.predict(X_test[ai_idx].reshape(1, -1))[0]\n","axes[1, 0].imshow(raw_test[ai_idx])\n","axes[1, 0].set_title(f\"FAKE Фото (з Диску)\\nПередбачено: {label_map[pred_ai]}\")\n","axes[1, 0].axis('off')\n","\n","axes[1, 1].imshow(spec_test[ai_idx], cmap='magma')\n","axes[1, 1].set_title(\"Спектр Фур'є (FAKE)\")\n","axes[1, 1].axis('off')\n","\n","plt.tight_layout()\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"LtS5-GiIwHfP","executionInfo":{"status":"ok","timestamp":1791202900523,"user_tz":-120,"elapsed":11280,"user":{"displayName":"john","userId":"09015409829148501583"}},"outputId":"c1751e5f-9c2b-45dc-fe8e-583181bc2f9c"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Зчитано з Google Диску: 113 REAL та 250 FAKE зображень.\n","Обробка зображень та обчислення спектрів Фур'є...\n","Навчання SVM-класифікатора...\n","\n","Точність (Accuracy) моделі: 76.71%\n","\n","--- Демонстрація перевірки ---\n","\n","[Реальне фото]\n","  Дійсний клас:       REAL (Реальне)\n","  Передбачення моделі: FAKE (Згенероване ШІ)\n","  Впевненість:         76.65%\n","\n","[ШІ фото]\n","  Дійсний клас:       FAKE (Згенероване ШІ)\n","  Передбачення моделі: FAKE (Згенероване ШІ)\n","  Впевненість:         87.70%\n"]},{"output_type":"display_data","data":{